import json
from sentence_transformers import SentenceTransformer

print("1. Инициализация модели для пайплайна извлечения признаков...")
model = SentenceTransformer('all-MiniLM-L6-v2')

print("2. Загрузка данных...")
input_file = "data/tracks.jsonl"
output_file = "data/tracks_pipeline_output.jsonl"

tracks = []
with open(input_file, "r", encoding="utf-8") as f:
    for line in f:
        tracks.append(json.loads(line))

captions = [t.get("caption", "") for t in tracks]

print("3. Запуск пайплайна извлечения эмбеддингов...")
embeddings = model.encode(captions, batch_size=32, show_progress_bar=True)

for i, track in enumerate(tracks):
    track["feature_vector"] = embeddings[i].tolist()

print("4. Сохранение результатов пайплайна...")
with open(output_file, "w", encoding="utf-8") as f:
    for track in tracks:
        f.write(json.dumps(track, ensure_ascii=False) + "\n")

print(f"Пайплайн успешно выполнен. Обработано треков: {len(tracks)}")
